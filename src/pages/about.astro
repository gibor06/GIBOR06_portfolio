---
import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@data/profile';
---

<BaseLayout
  title="About Tran Gia Bao (gibor06) — Software Engineer & Researcher"
  description="Background, academic focus, engineering principles, and institutional coursework of Tran Gia Bao (gibor06)."
  lang="en"
  activePath="/about"
>
  <div class="py-16 md:py-28 border-b border-white/[0.08]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- Top Title -->
      <div class="space-y-3">
        <span class="font-mono text-xs text-blue-400 uppercase tracking-widest block">DOSSIER</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          About Trần Gia Bảo
        </h1>
        <p class="text-sm sm:text-base text-zinc-400 max-w-2xl font-light leading-relaxed">
          Software engineering fundamentals, applied AI research, and academic rigor at Ho Chi Minh City University of Industry and Trade (HUIT).
        </p>
      </div>

      <!-- Candid Portrait & Bio (12 Cols) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start pb-16 border-b border-white/[0.08]">
        <div class="md:col-span-5">
          <div class="img-editorial-reveal border border-white/10 bg-[#0d0f11]">
            <img
              src="/portfolio/assets/img/avatar-gibor06.jpg"
              alt="Portrait of Tran Gia Bao"
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
        </div>

        <div class="md:col-span-7 space-y-6">
          <div class="space-y-1">
            <h2 class="text-2xl font-bold text-white">{profile.vietnameseName}</h2>
            <p class="font-mono text-xs text-zinc-400">@{profile.handle} • {profile.location}</p>
          </div>

          <p class="text-base text-zinc-300 font-light leading-relaxed">
            {profile.bioEn}
          </p>

          <p class="text-sm text-zinc-400 font-light leading-relaxed">
            Second-year Information Technology student at HUIT with a primary academic focus on High-Utility Itemset Mining (EMHUN), Vietnamese transformer NLP models (PhoBERT), and systems-level algorithmic programming in C/C++ and Java.
          </p>

          <div class="pt-4 border-t border-white/[0.08] flex items-center gap-6 font-mono text-xs">
            <a href={profile.github} target="_blank" rel="noreferrer" class="text-white hover:text-blue-400 transition-colors">GitHub ↗</a>
            <a href={profile.linkedin} target="_blank" rel="noreferrer" class="text-white hover:text-blue-400 transition-colors">LinkedIn ↗</a>
            <a href={`mailto:${profile.email}`} class="text-white hover:text-blue-400 transition-colors">Email ↗</a>
          </div>
        </div>
      </div>

      <!-- Education Ledger -->
      <div class="space-y-8 pb-16 border-b border-white/[0.08]">
        <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block">
          01 // INSTITUTIONAL AFFILIATION & EDUCATION
        </span>

        <div class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-zinc-400">
            <span class="text-white font-bold">{profile.institutionEn}</span>
            <span>2024 — Present (Enrolled)</span>
          </div>

          <h3 class="text-xl font-bold text-white">
            Bachelor of Science in Information Technology (Computer Science)
          </h3>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-4 border-y border-white/[0.08] font-mono">
            <div>
              <span class="meta-rail-label block">GPA (10.0)</span>
              <strong class="text-emerald-400 text-lg font-bold">8.78 / 10</strong>
            </div>
            <div>
              <span class="meta-rail-label block">GPA (4.0)</span>
              <strong class="text-emerald-400 text-lg font-bold">3.78 / 4.0</strong>
            </div>
            <div>
              <span class="meta-rail-label block">CREDITS</span>
              <strong class="text-white text-lg font-bold">54</strong>
            </div>
            <div>
              <span class="meta-rail-label block">RANKING</span>
              <strong class="text-blue-400 text-lg font-bold">Distinction</strong>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
            Faculty of Information Technology • Key Coursework: Data Structures & Algorithms, Object-Oriented Programming (Java/C++), Database Systems, Computer Networks, Applied Artificial Intelligence.
          </p>
        </div>
      </div>

      <!-- Engineering Principles -->
      <div class="space-y-8">
        <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block">
          02 // ENGINEERING PRINCIPLES & WORKING PHILOSOPHY
        </span>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
          <div class="space-y-2 pb-6 border-b border-white/[0.06]">
            <span class="font-mono text-xs text-blue-400 font-bold">01 // EVIDENCE & BENCHMARKING</span>
            <h4 class="text-base font-bold text-white">Proof Over Assumptions</h4>
            <p class="text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
              Engineering claims must be validated with quantitative benchmarks, reproducible test datasets, memory profiling, and verifiable metrics.
            </p>
          </div>

          <div class="space-y-2 pb-6 border-b border-white/[0.06]">
            <span class="font-mono text-xs text-emerald-400 font-bold">02 // DEEP FUNDAMENTALS</span>
            <h4 class="text-base font-bold text-white">Algorithms & Architecture First</h4>
            <p class="text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
              Frameworks change rapidly, but deep knowledge of data structures, algorithmic complexity, memory management, and deterministic systems design remains timeless.
            </p>
          </div>

          <div class="space-y-2 pb-6 border-b border-white/[0.06]">
            <span class="font-mono text-xs text-amber-400 font-bold">03 // BRIDGING RESEARCH & DELIVERY</span>
            <h4 class="text-base font-bold text-white">Academic Rigor Meets Production</h4>
            <p class="text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
              Connecting theoretical data mining algorithms and machine learning architectures with clean, production-grade web and systems software.
            </p>
          </div>

          <div class="space-y-2 pb-6 border-b border-white/[0.06]">
            <span class="font-mono text-xs text-blue-300 font-bold">04 // PERFORMANCE & ACCESSIBILITY</span>
            <h4 class="text-base font-bold text-white">Zero Bloat & Fast Delivery</h4>
            <p class="text-xs sm:text-sm text-zinc-400 font-light leading-relaxed">
              Prioritizing static-first architectures, sub-second load times, strict WCAG 2.2 AA accessibility standards, and semantic HTML structure.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

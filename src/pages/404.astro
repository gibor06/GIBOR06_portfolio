---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from '@i18n/utils';
---

<BaseLayout
  title="404 — Route Not Found | Trần Gia Bảo (gibor06)"
  description="The requested page could not be found in the GIBOR06 Portfolio."
  lang="en"
  activePath="/404"
>
  <section class="py-28 sm:py-36">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="border border-white/[0.16] bg-[#0a0e16] p-8 sm:p-14 space-y-6">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#4d8dff]">
          HTTP 404 // ROUTE NOT FOUND
        </div>
        <h1 class="display-hero-title">404</h1>
        <p class="text-base sm:text-lg text-zinc-300 leading-relaxed max-w-xl">
          The page or case study URL you requested does not exist or has been relocated to the Interview Edition 2026 archive.
        </p>
        <div class="pt-4 flex flex-wrap gap-3">
          <a href={getRelativeLocaleUrl("en", "/")} class="swiss-btn-primary">
            <span>Return to Portfolio Home (EN) →</span>
          </a>
          <a href={getRelativeLocaleUrl("vi", "/")} class="swiss-btn-secondary">
            <span>Về Trang Chủ Tiếng Việt (VI) →</span>
          </a>
          <a href={getRelativeLocaleUrl("en", "/work")} class="swiss-btn-secondary">
            <span>Explore Projects Archive →</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

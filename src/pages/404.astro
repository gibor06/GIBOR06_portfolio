---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from '@i18n/utils';
---

<BaseLayout
  title="404 — Page Not Found | Trần Gia Bảo (gibor06)"
  description="The requested engineering resource or page was not found."
  lang="en"
>
  <div class="py-24 md:py-36 text-center">
    <div class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8 space-y-6">
      <span class="badge-mono text-red-400 bg-red-500/10 border-red-500/20">
        ERROR 404
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Route Not Found
      </h1>
      <p class="text-zinc-400 text-sm leading-relaxed">
        The page you are trying to reach does not exist or has been relocated in Portfolio V4.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <a
          href={getRelativeLocaleUrl("en", "/")}
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-500 transition-colors"
        >
          ← Return to Home
        </a>
        <a
          href={getRelativeLocaleUrl("en", "/work")}
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-zinc-300 hover:text-white transition-colors"
        >
          View Selected Work
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

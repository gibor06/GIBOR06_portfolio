---
import BaseLayout from '@layouts/BaseLayout.astro';
import { certificates } from '@data/certificates';

const aiCerts = certificates.filter((c) => c.category === "ai");
const dataCerts = certificates.filter((c) => c.category === "data");
---

<BaseLayout
  title="Chứng Chỉ & Bằng Cấp Chuyên Môn — Trần Gia Bảo (gibor06)"
  description="Danh mục các chứng chỉ chuyên môn Google AI Essentials, Gemini for Faculty và Google Data Analytics của Trần Gia Bảo."
  lang="vi"
  activePath="/vi/credentials"
>
  <div class="py-16 md:py-24 border-b border-white/[0.08]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="space-y-3">
        <div class="tech-divider">
          <span>HỒ SƠ CHỨNG CHỈ</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Chứng Chỉ Chuyên Môn & Đào Tạo
        </h1>
        <p class="text-sm sm:text-base text-zinc-400 max-w-2xl leading-relaxed">
          Danh mục đầy đủ các chứng nhận chuyên sâu từ Google và Coursera về Trí tuệ Nhân tạo, AI tạo sinh và Phân tích dữ liệu.
        </p>
      </div>

      <!-- Google AI & Gemini Specializations -->
      <div class="space-y-6">
        <h3 class="text-xs font-mono uppercase tracking-wider text-blue-400">
          01 // CHỨNG CHỈ GOOGLE AI & GEMINI ({aiCerts.length})
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {aiCerts.map((cert) => (
            <article class="studio-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="overflow-hidden rounded border border-white/10 bg-[#0d0f11] h-36">
                  <img
                    src={cert.imagePath}
                    alt={cert.titleVi}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500">
                  <span class="text-blue-400 font-semibold">{cert.issuer}</span>
                  <span class="uppercase">{cert.category}</span>
                </div>
                <h4 class="text-sm font-bold text-white leading-snug">
                  {cert.titleVi}
                </h4>
              </div>

              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
                <button
                  type="button"
                  data-lightbox
                  data-src={cert.imagePath}
                  data-caption={cert.titleVi}
                  class="text-blue-400 hover:underline"
                >
                  Xem ảnh ↗
                </button>
                {cert.pdfPath && (
                  <a href={cert.pdfPath} target="_blank" rel="noreferrer" class="text-zinc-500 hover:text-zinc-300">
                    File PDF
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Google Data Analytics Modules -->
      <div class="space-y-6 pt-8 border-t border-white/[0.08]">
        <h3 class="text-xs font-mono uppercase tracking-wider text-amber-400">
          02 // CHỨNG CHỈ GOOGLE DATA ANALYTICS ({dataCerts.length})
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {dataCerts.map((cert) => (
            <article class="studio-card p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="overflow-hidden rounded border border-white/10 bg-[#0d0f11] h-36">
                  <img
                    src={cert.imagePath}
                    alt={cert.titleVi}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500">
                  <span class="text-amber-400 font-semibold">{cert.issuer}</span>
                  <span class="uppercase">{cert.category}</span>
                </div>
                <h4 class="text-sm font-bold text-white leading-snug">
                  {cert.titleVi}
                </h4>
              </div>

              <div class="pt-3 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono">
                <button
                  type="button"
                  data-lightbox
                  data-src={cert.imagePath}
                  data-caption={cert.titleVi}
                  class="text-blue-400 hover:underline"
                >
                  Xem ảnh ↗
                </button>
                {cert.pdfPath && (
                  <a href={cert.pdfPath} target="_blank" rel="noreferrer" class="text-zinc-500 hover:text-zinc-300">
                    File PDF
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import FeaturedProjects from '@components/home/FeaturedProjects.astro';
import ResearchTimeline from '@components/home/ResearchTimeline.astro';
import RecognitionList from '@components/home/RecognitionList.astro';
import EngineeringProfile from '@components/home/EngineeringProfile.astro';
import CertificationsGrid from '@components/home/CertificationsGrid.astro';
import AcademicSnapshot from '@components/home/AcademicSnapshot.astro';
import ContactSection from '@components/home/ContactSection.astro';
---

<BaseLayout
  title="Trần Gia Bảo (gibor06) — Kỹ Sư Phần Mềm & Trí Tuệ Nhân Tạo Ứng Dụng"
  description="Hồ sơ năng lực kỹ thuật của Trần Gia Bảo (gibor06): nghiên cứu Khai phá dữ liệu EMHUN, mô hình Transformer PhoBERT, hệ thống phần mềm C/C++ và thành tích học thuật chính thức tại HUIT."
  lang="vi"
  activePath="/vi"
>
  <Hero lang="vi" />
  <FeaturedProjects lang="vi" />
  <ResearchTimeline lang="vi" />
  <RecognitionList lang="vi" />
  <EngineeringProfile lang="vi" />
  <CertificationsGrid lang="vi" />
  <AcademicSnapshot lang="vi" />
  <ContactSection lang="vi" />
</BaseLayout>

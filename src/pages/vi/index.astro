---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import AboutSection from '@components/home/AboutSection.astro';
import ExpertiseSection from '@components/home/ExpertiseSection.astro';
import SelectedWorksSection from '@components/home/SelectedWorksSection.astro';
import ResearchSection from '@components/home/ResearchSection.astro';
import AchievementsSection from '@components/home/AchievementsSection.astro';
import ContactSection from '@components/home/ContactSection.astro';
---

<BaseLayout
  title="Trần Gia Bảo (gibor06) — Studio Kỹ Thuật Phần Mềm & Kiến Trúc UI/UX"
  description="Nơi thiết kế UI/UX lấy con người làm trung tâm gặp gỡ kỹ thuật Full-Stack bền bỉ. Không gian sáng tạo, thành tích giải thưởng và nghiên cứu FAIR XIX 2026 của Trần Gia Bảo (gibor06) tại HUIT."
  lang="vi"
  activePath="/vi"
>
  <Hero lang="vi" />
  <AboutSection lang="vi" />
  <ExpertiseSection lang="vi" />
  <SelectedWorksSection lang="vi" />
  <ResearchSection lang="vi" />
  <AchievementsSection lang="vi" />
  <ContactSection lang="vi" />
</BaseLayout>

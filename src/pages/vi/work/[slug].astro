---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectDetailView from '@components/work/ProjectDetailView.astro';
import { engineeringProjects, type EngineeringProject } from '@data/projects';

export function getStaticPaths() {
  const paths: { params: { slug: string }; props: { project: EngineeringProject } }[] = [];

  for (const project of engineeringProjects) {
    paths.push({
      params: { slug: project.slug },
      props: { project },
    });

    if (project.legacySlugs) {
      for (const legacySlug of project.legacySlugs) {
        paths.push({
          params: { slug: legacySlug },
          props: { project },
        });
      }
    }
  }

  return paths;
}

interface Props {
  project: EngineeringProject;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.titleVi} — Case Study Kỹ Thuật | Trần Gia Bảo`}
  description={project.shortDescVi}
  image={project.coverImage}
  lang="vi"
  activePath={`/vi/work/${project.slug}`}
>
  <ProjectDetailView project={project} lang="vi" />
</BaseLayout>

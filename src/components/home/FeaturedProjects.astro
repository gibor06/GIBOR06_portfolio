---
import { getFeaturedProjects, getSecondaryProjects } from '@data/projects';
import { getRelativeLocaleUrl, withBase } from '@i18n/utils';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";

const featuredProjects = getFeaturedProjects();
const secondaryProjects = getSecondaryProjects();
---

<section id="projects" class="relative py-20 sm:py-28 border-b border-white/[0.14]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Section Header -->
    <div class="reveal-on-scroll flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-white/[0.14] pb-8">
      <div class="space-y-3">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#4d8dff]">
          01 // {isVi ? "DỰ ÁN PHẦN MỀM TRỌNG ĐIỂM" : "FEATURED FULL-STACK & SOFTWARE SYSTEMS"}
        </div>
        <h2 class="display-section-title uppercase">
          {isVi ? "Hệ Thống Phần Mềm & Case Studies" : "Production-Minded Engineering Case Studies"}
        </h2>
      </div>
      <div class="max-w-xl space-y-3">
        <p class="text-sm text-zinc-300 leading-relaxed">
          {isVi
            ? "Ba hệ thống phần mềm chủ lực minh chứng năng lực xây dựng ứng dụng từ Cơ sở dữ liệu SQL Server, Backend C# / ASP.NET Core 8.0 MVC & Web API, ứng dụng Desktop WPF MVVM cho đến giao diện Web đa thiết bị và tích hợp cổng thanh toán thực tế."
            : "Three primary software systems demonstrating end-to-end execution across SQL Server database design, C# / ASP.NET Core 8.0 MVC & Web API backends, WPF MVVM desktop POS clients, and responsive web interfaces with live payment integration."}
        </p>
        <a
          href={getRelativeLocaleUrl(lang, "/work")}
          class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-[#4d8dff] hover:text-white transition-colors"
        >
          <span>{isVi ? "Xem toàn bộ danh mục dự án (5 hệ thống)" : "View Full Project Archive (5 Systems)"}</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Primary Featured Projects (Full-Bleed Architectural Dossiers) -->
    <div class="space-y-16">
      {featuredProjects.map((project, index) => {
        const title = isVi ? project.titleVi : project.titleEn;
        const subtitle = isVi ? project.subtitleVi : project.subtitleEn;
        const category = isVi ? project.categoryVi : project.category;
        const role = isVi ? project.roleVi : project.roleEn;
        const team = isVi ? project.teamInfoVi : project.teamInfoEn;
        const summary = isVi ? project.shortDescVi : project.shortDescEn;
        const contributions = (isVi ? project.candidateContributionsVi : project.candidateContributionsEn).slice(0, 3);
        const detailUrl = getRelativeLocaleUrl(lang, `/work/${project.slug}`);
        const bgImage = withBase(project.secondaryImage || project.coverImage);
        const primaryShot = withBase(project.coverImage);

        return (
          <article class="reveal-on-scroll relative border border-white/[0.16] bg-[#0a0e16] overflow-hidden group">
            <!-- Large Full-Bleed Atmospheric Project Screenshot Background -->
            <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden">
              <img
                src={bgImage}
                alt=""
                aria-hidden="true"
                class="h-full w-full object-cover object-center opacity-22 group-hover:scale-[1.02] transition-transform duration-700 filter contrast-115"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-[#07090e] via-[#07090e]/92 to-[#07090e]/75"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-transparent to-[#07090e]/85"></div>
            </div>

            <!-- Top Structural Metadata Bar -->
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-4 border-b border-white/[0.14] bg-[#07090e]/90 px-6 py-3.5 font-mono text-xs">
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-[#4d8dff] font-bold">0{index + 1} // CASE STUDY</span>
                <span class="text-zinc-600">|</span>
                <span class="text-white font-semibold uppercase tracking-wider">{category}</span>
              </div>
              <div class="flex flex-wrap items-center gap-4 text-[11px] text-zinc-400 uppercase tracking-wider">
                <span>{isVi ? project.timelineVi : project.timelineEn}</span>
                <span class="text-zinc-600">•</span>
                <span class="text-zinc-200">{role}</span>
              </div>
            </div>

            <!-- Main 12-Column Case Study Body -->
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12">
              <!-- Left 7 Columns: Engineering Narrative & Personal Contributions -->
              <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 lg:border-r border-white/[0.14] flex flex-col justify-between space-y-8">
                <div class="space-y-5">
                  <div class="space-y-2">
                    <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight uppercase leading-[1.08]">
                      <a href={detailUrl} class="hover:text-[#4d8dff] transition-colors">
                        {title}
                      </a>
                    </h3>
                    <p class="font-mono text-xs sm:text-sm text-[#4d8dff]">
                      {subtitle}
                    </p>
                  </div>

                  <p class="text-sm sm:text-base text-zinc-200 leading-relaxed">
                    {summary}
                  </p>

                  <!-- Verified Personal Contribution Highlights -->
                  <div class="border border-white/[0.12] bg-[#07090e]/85 p-5 space-y-3">
                    <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-wider">
                      <span class="text-[#4d8dff] font-bold">
                        {isVi ? "ĐÓNG GÓP KỸ THUẬT TRỰC TIẾP" : "DIRECT ENGINEERING CONTRIBUTIONS"}
                      </span>
                      <span class="text-zinc-400">{team}</span>
                    </div>
                    <ul class="space-y-2 text-xs sm:text-sm text-zinc-300">
                      {contributions.map((item) => (
                        <li class="flex items-start gap-2.5">
                          <span class="font-mono text-[#4d8dff] mt-0.5">▪</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Stack Badges -->
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {project.technologies.map((tech) => (
                      <span class="swiss-tag">{tech}</span>
                    ))}
                  </div>
                </div>

                <!-- Action Links -->
                <div class="pt-6 border-t border-white/[0.14] flex flex-wrap items-center justify-between gap-4">
                  <a href={detailUrl} class="swiss-btn-primary">
                    <span>{isVi ? "Đọc Case Study Chi Tiết" : "Read Full Engineering Case Study"}</span>
                    <span>→</span>
                  </a>

                  <div class="flex flex-wrap items-center gap-3">
                    {project.demoUrl && (
                      <a
                        href={project.demoUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="swiss-btn-secondary !px-4 !py-2.5 border-emerald-500/40 text-emerald-300 hover:text-white"
                      >
                        <span class="inline-block h-2 w-2 bg-emerald-400"></span>
                        <span>{isVi ? "Bản Demo Thực Tế ↗" : "Live Demo ↗"}</span>
                      </a>
                    )}
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="swiss-btn-secondary !px-4 !py-2.5"
                    >
                      <span>{isVi ? "Mã Nguồn GitHub ↗" : "GitHub Repo ↗"}</span>
                    </a>
                  </div>
                </div>
              </div>

              <!-- Right 5 Columns: Visual Evidence Frame + Architecture Metrics -->
              <div class="lg:col-span-5 flex flex-col justify-between bg-[#07090e]/75 border-t lg:border-t-0 border-white/[0.14]">
                <!-- Interactive Visual Preview -->
                <div class="p-6 sm:p-8 space-y-4">
                  <div class="flex items-center justify-between font-mono text-[11px] text-zinc-400 uppercase tracking-wider">
                    <span>{isVi ? "GIAO DIỆN & KIẾN TRÚC THỰC TẾ" : "SYSTEM INTERFACE & ARCHITECTURE"}</span>
                    <button
                      type="button"
                      data-lightbox
                      data-src={primaryShot}
                      data-caption={`${title} — ${subtitle}`}
                      class="text-[#4d8dff] hover:text-white uppercase tracking-wider cursor-pointer"
                    >
                      {isVi ? "[Phóng to ↗]" : "[Inspect Full Image ↗]"}
                    </button>
                  </div>

                  <a
                    href={detailUrl}
                    class="block border border-white/20 bg-[#05070b] overflow-hidden img-editorial-reveal"
                  >
                    <img
                      src={primaryShot}
                      alt={title}
                      class="w-full h-56 sm:h-64 object-cover object-top"
                      loading="lazy"
                    />
                  </a>

                  <!-- Secondary Thumbnails Strip -->
                  {project.gallery.length > 1 && (
                    <div class="grid grid-cols-3 gap-2.5 pt-1">
                      {project.gallery.slice(0, 3).map((shot) => (
                        <button
                          type="button"
                          data-lightbox
                          data-src={withBase(shot.src)}
                          data-caption={isVi ? shot.captionVi : shot.captionEn}
                          class="border border-white/15 bg-[#05070b] overflow-hidden hover:border-[#4d8dff] transition-colors text-left cursor-pointer group/shot"
                        >
                          <img
                            src={withBase(shot.src)}
                            alt={isVi ? shot.captionVi : shot.captionEn}
                            class="h-16 w-full object-cover object-top group-hover/shot:scale-105 transition-transform"
                            loading="lazy"
                          />
                        </button>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Quantitative / Structural Evidence Spec Grid (Verified from Source Code) -->
                <div class="grid grid-cols-2 border-t border-white/[0.14] divide-x divide-y divide-white/[0.14] bg-[#07090e]">
                  {project.verifiedHighlights.map((m) => (
                    <div class="p-4 sm:p-5">
                      <div class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">
                        {isVi ? m.labelVi : m.labelEn}
                      </div>
                      <div class="mt-1 font-mono text-sm sm:text-base font-bold text-white">
                        {m.value}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Secondary / Foundational Engineering Projects -->
    <div class="reveal-on-scroll pt-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/[0.14] pb-4">
        <div>
          <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-zinc-400">
            01.B // {isVi ? "DỰ ÁN NỀN TẢNG & CẤU TRÚC DỮ LIỆU" : "FOUNDATIONAL SYSTEMS & DATA STRUCTURES"}
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white uppercase mt-1">
            {isVi ? "Cấu Trúc Dữ Liệu C/C++ & Nền Tảng Web" : "Core C/C++ Algorithms & Early Web Engineering"}
          </h3>
        </div>
        <span class="font-mono text-xs text-zinc-500 uppercase">
          {isVi ? "Đồ án học thuật tại HUIT" : "Verified HUIT Coursework Projects"}
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-white/[0.14]">
        {secondaryProjects.map((project, idx) => {
          const title = isVi ? project.titleVi : project.titleEn;
          const subtitle = isVi ? project.subtitleVi : project.subtitleEn;
          const summary = isVi ? project.shortDescVi : project.shortDescEn;
          const detailUrl = getRelativeLocaleUrl(lang, `/work/${project.slug}`);

          return (
            <article class="border-r border-b border-white/[0.14] bg-[#0a0e16]/90 p-6 sm:p-8 flex flex-col justify-between gap-6 hover:bg-white/[0.02] transition-colors">
              <div class="space-y-4">
                <div class="flex items-center justify-between font-mono text-xs text-zinc-400">
                  <span class="text-[#4d8dff] font-bold">0{idx + 4} // {project.year}</span>
                  <span class="uppercase">{isVi ? project.categoryVi : project.category}</span>
                </div>
                <div class="space-y-1.5">
                  <h4 class="text-xl font-extrabold text-white uppercase tracking-tight">
                    <a href={detailUrl} class="hover:text-[#4d8dff] transition-colors">
                      {title}
                    </a>
                  </h4>
                  <p class="font-mono text-xs text-zinc-400">{subtitle}</p>
                </div>
                <p class="text-sm text-zinc-300 leading-relaxed">
                  {summary}
                </p>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {project.technologies.map((tech) => (
                    <span class="swiss-tag">{tech}</span>
                  ))}
                </div>
              </div>

              <div class="pt-4 border-t border-white/[0.12] flex items-center justify-between font-mono text-xs">
                <a href={detailUrl} class="text-white hover:text-[#4d8dff] font-bold uppercase tracking-wider">
                  {isVi ? "Xem Chi Tiết →" : "Inspect Case Study →"}
                </a>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="text-zinc-400 hover:text-white uppercase tracking-wider"
                >
                  GitHub ↗
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

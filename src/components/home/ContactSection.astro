---
export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
---

<section id="contact" class="py-20 sm:py-28 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="border-2 border-[var(--line-strong)] bg-[var(--bg-elevated)] shadow-[10px_10px_0px_#d9532f] reveal-on-scroll">
      <!-- Top Architectural Header Strip -->
      <div class="grid grid-cols-1 lg:grid-cols-12 border-b-2 border-[var(--line-strong)]">
        <div class="lg:col-span-8 p-8 sm:p-12 lg:p-16 space-y-6 border-b lg:border-b-0 lg:border-r border-[var(--line-strong)]">
          <div class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.24em] text-[var(--accent-secondary)]">
            <span class="h-2.5 w-2.5 bg-[#d9532f]"></span>
            <span>05 // CONTACT — INITIATE DIALOGUE</span>
          </div>

          <h2 class="font-editorial text-4xl sm:text-6xl lg:text-[4.25rem] font-bold text-[var(--text)] leading-[0.98] tracking-tight">
            {lang === "vi"
              ? "Cùng kiến tạo những hệ thống có chiều sâu."
              : "Let’s architect enduring digital products."}
          </h2>

          <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-relaxed max-w-2xl">
            {lang === "vi"
              ? "Luôn sẵn sàng cho các cuộc đối thoại về thiết kế hệ thống UI/UX, kỹ thuật phần mềm Full-Stack và hợp tác nghiên cứu thuật toán tối ưu."
              : "Open for conversations on human-centered UI/UX systems, Full-Stack software engineering, and collaborative algorithmic research."}
          </p>
        </div>

        <!-- Right 4 Columns: Geometric Studio Stamp -->
        <div class="lg:col-span-4 bg-[#143a8a] text-white keep-white p-8 sm:p-12 flex flex-col justify-between">
          <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-[#ffd4c8] keep-white font-bold">
            GIBOR06 STUDIO // SAIGON, VIETNAM
          </div>
          <div class="my-6 space-y-2">
            <div class="font-editorial italic text-3xl sm:text-4xl font-bold text-white keep-white">
              Trần Gia Bảo
            </div>
            <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-white/80 keep-white">
              SOFTWARE ENGINEERING • HUIT
            </div>
          </div>
          <div class="h-1.5 w-20 bg-[#d9532f]"></div>
        </div>
      </div>

      <!-- Bottom 3 Direct Channels Grid (Email, GitHub, LinkedIn) -->
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--line-strong)]">
        <!-- Channel 01: Email -->
        <a
          href="mailto:gibor06.dev@gmail.com"
          class="p-8 sm:p-10 flex flex-col justify-between space-y-4 hover:bg-[var(--bg-panel)] transition-colors group"
        >
          <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--accent-secondary)] font-bold">
            <span>01 // ELECTRONIC MAIL</span>
            <span>↗</span>
          </div>
          <div class="font-editorial text-2xl sm:text-3xl font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors break-all">
            gibor06.dev@gmail.com
          </div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-muted)]">
            {lang === "vi" ? "LIÊN HỆ TRỰC TIẾP" : "DIRECT CORRESPONDENCE"}
          </div>
        </a>

        <!-- Channel 02: GitHub -->
        <a
          href="https://github.com/gibor06"
          target="_blank"
          rel="noreferrer"
          class="p-8 sm:p-10 flex flex-col justify-between space-y-4 hover:bg-[var(--bg-panel)] transition-colors group"
        >
          <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--accent-secondary)] font-bold">
            <span>02 // SOURCE ARCHIVE</span>
            <span>↗</span>
          </div>
          <div class="font-editorial text-2xl sm:text-3xl font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
            github.com/gibor06
          </div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-muted)]">
            {lang === "vi" ? "KHO LƯU TRỮ MÃ NGUỒN" : "OPEN-SOURCE & ARCHITECTURES"}
          </div>
        </a>

        <!-- Channel 03: LinkedIn -->
        <a
          href="https://www.linkedin.com/in/gibor06"
          target="_blank"
          rel="noreferrer"
          class="p-8 sm:p-10 flex flex-col justify-between space-y-4 hover:bg-[var(--bg-panel)] transition-colors group"
        >
          <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--accent-secondary)] font-bold">
            <span>03 // PROFESSIONAL NETWORK</span>
            <span>↗</span>
          </div>
          <div class="font-editorial text-2xl sm:text-3xl font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
            linkedin.com/in/gibor06
          </div>
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--text-muted)]">
            {lang === "vi" ? "KẾT NỐI CHUYÊN MÔN" : "EXECUTIVE PROFILE"}
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

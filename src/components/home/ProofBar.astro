---
import { profile } from '@data/profile';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
---

<div class="border-b border-white/10 bg-[#0d0d10]/60 py-4 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
    <!-- Proof 1: GPA -->
    <a
      href={profile.academic.transcriptUrl}
      target="_blank"
      rel="noreferrer"
      class="flex items-center gap-2 text-zinc-300 hover:text-white transition-colors"
      title="View official verified transcript on HUIT portal"
    >
      <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
      <span class="text-zinc-400">{lang === "vi" ? "GPA Tích Lũy:" : "GPA:"}</span>
      <strong class="text-white font-bold">8.78 / 10.0 (3.78/4.0)</strong>
      <svg class="h-3 w-3 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <!-- Proof 2: Research Finalist -->
    <a
      href="https://fit.huit.edu.vn/nghien-cuu/thong-bao-so-3-to-chuc-vong-chung-ket-cuoc-thi-nckh-sv-2025-2026"
      target="_blank"
      rel="noreferrer"
      class="flex items-center gap-2 text-zinc-300 hover:text-white transition-colors"
    >
      <span class="h-2 w-2 rounded-full bg-blue-400"></span>
      <span class="text-zinc-400">{lang === "vi" ? "Nghiên Cứu:" : "Research:"}</span>
      <strong class="text-white font-semibold">{lang === "vi" ? "Chung Kết NCKH Cấp Trường 2026" : "University NCKH Finalist 2026"}</strong>
      <svg class="h-3 w-3 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <!-- Proof 3: Awards Count -->
    <a
      href="#achievements"
      class="flex items-center gap-2 text-zinc-300 hover:text-white transition-colors"
    >
      <span class="h-2 w-2 rounded-full bg-amber-400"></span>
      <span class="text-zinc-400">{lang === "vi" ? "Thành Tích:" : "Awards:"}</span>
      <strong class="text-white font-semibold">{lang === "vi" ? "08+ Giải Thưởng Khoa Học" : "08+ Verified Awards"}</strong>
    </a>

    <!-- Proof 4: Institution -->
    <div class="hidden md:flex items-center gap-2 text-zinc-400">
      <span>{profile.institutionEn}</span>
    </div>
  </div>
</div>

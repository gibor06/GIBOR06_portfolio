---
import { achievements } from '@data/achievements';
import { getRelativeLocaleUrl, withBase } from '@i18n/utils';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section id="achievements" class="relative py-20 sm:py-28 border-b border-white/[0.14] bg-[#07090e]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Section Header -->
    <div class="reveal-on-scroll flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-white/[0.14] pb-8">
      <div class="space-y-3">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#4d8dff]">
          04 // {isVi ? "GIẢI THƯỞNG & HỌC BỔNG ĐÃ XÁC THỰC" : "VERIFIED HONOURS & ACADEMIC DISTINCTIONS"}
        </div>
        <h2 class="display-section-title uppercase">
          {isVi ? "Giải Thưởng Nghiên Cứu & Học Thuật" : "Honours, Awards & Scholarships"}
        </h2>
      </div>
      <a
        href={getRelativeLocaleUrl(lang, "/credentials")}
        class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-[#4d8dff] hover:text-white transition-colors"
      >
        <span>{isVi ? "Xem toàn bộ hồ sơ chứng chỉ & giải thưởng" : "View Full Credentials Archive"}</span>
        <span>→</span>
      </a>
    </div>

    <!-- Achievements Grid -->
    <div class="reveal-on-scroll grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-white/[0.14]">
      {achievements.filter((a) => a.featured).map((item, idx) => {
        const title = isVi ? item.titleVi : item.titleEn;
        const org = item.organization;
        const desc = isVi ? item.descriptionVi : item.descriptionEn;
        const imgSrc = item.imagePath ? withBase(item.imagePath) : "";

        return (
          <article class="border-r border-b border-white/[0.14] bg-[#0a0e16] flex flex-col justify-between group">
            <div>
              {imgSrc && (
                <button
                  type="button"
                  data-lightbox
                  data-src={imgSrc}
                  data-caption={`${title} — ${org} (${item.date})`}
                  class="relative block w-full h-48 border-b border-white/[0.14] bg-[#05070b] overflow-hidden cursor-pointer text-left"
                >
                  <img
                    src={imgSrc}
                    alt={title}
                    class="h-full w-full object-cover object-center opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3 border border-white/20 bg-[#07090e]/90 px-2.5 py-1 font-mono text-[10px] font-bold text-[#4d8dff] uppercase tracking-wider">
                    0{idx + 1} // {item.date}
                  </div>
                  <div class="absolute bottom-3 right-3 border border-white/25 bg-[#07090e]/90 px-2.5 py-1 font-mono text-[10px] text-white uppercase tracking-wider">
                    {isVi ? "Xem ảnh ↗" : "Inspect ↗"}
                  </div>
                </button>
              )}

              <div class="p-6 space-y-3">
                <div class="font-mono text-[11px] text-zinc-400 uppercase tracking-wider">
                  {org}
                </div>
                <h3 class="text-lg font-extrabold text-white leading-snug">
                  {title}
                </h3>
                <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
                  {desc}
                </p>
              </div>
            </div>

            <div class="px-6 py-3.5 border-t border-white/[0.10] bg-[#07090e]/60 flex items-center justify-between font-mono text-[11px]">
              <span class="text-emerald-400 uppercase tracking-wider">
                {isVi ? item.scopeVi : item.scopeEn}
              </span>
              {imgSrc && (
                <button
                  type="button"
                  data-lightbox
                  data-src={imgSrc}
                  data-caption={`${title} — ${org} (${item.date})`}
                  class="text-zinc-300 hover:text-[#4d8dff] uppercase tracking-wider cursor-pointer"
                >
                  {isVi ? "Phóng to giấy khen →" : "Open Certificate →"}
                </button>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

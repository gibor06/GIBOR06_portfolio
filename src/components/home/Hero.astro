---
export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;

const matrixCells = [
  {
    index: "01 // ARCH",
    title: "UI/UX & Systems Architecture",
    titleVi: "UI/UX & Kiến Trúc Hệ Thống",
    desc: "Editorial grids, adaptive token architecture & human-first spatial choreography.",
    descVi: "Lưới thị giác chuẩn mực, hệ thống design tokens thích ứng và tương tác lấy con người làm gốc.",
  },
  {
    index: "02 // CORE",
    title: "Full-Stack Engineering",
    titleVi: "Kỹ Thuật Phần Mềm Full-Stack",
    desc: "Cohesive multi-tier web and desktop ecosystems engineered for structural longevity.",
    descVi: "Kiến tạo hệ sinh thái ứng dụng đa tầng liền mạch, bền bỉ từ lõi nghiệp vụ đến giao diện.",
  },
  {
    index: "03 // DATA",
    title: "Data & Infrastructure",
    titleVi: "Dữ Liệu & Hạ Tầng Bền Vững",
    desc: "Normalized relational foundations, transactional integrity & real-time state pipelines.",
    descVi: "Nền tảng cơ sở dữ liệu chuẩn hóa, bảo toàn tính toàn vẹn giao dịch và đồng bộ tức thời.",
  },
  {
    index: "04 // AI",
    title: "Applied AI & Algorithms",
    titleVi: "Trí Tuệ Nhân Tạo & Thuật Toán Tối Ưu",
    desc: "Combinatorial optimization, metaheuristic search & peer-reviewed algorithmic models.",
    descVi: "Tối ưu hóa tổ hợp, thuật toán tìm kiếm tiến hóa và các mô hình trí tuệ nhân tạo ứng dụng.",
  },
];
---

<section id="studio" class="relative border-b-2 border-[var(--line-strong)] overflow-hidden editorial-grid-bg">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Main 12-Column Editorial / Brutalist Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 border-x border-[var(--line-strong)] bg-[var(--bg)]/90">
      
      <!-- Left 7 Columns: Monumental Typography & Studio Manifesto -->
      <div class="lg:col-span-7 p-6 sm:p-10 lg:p-14 border-b lg:border-b-0 lg:border-r border-[var(--line-strong)] flex flex-col justify-between">
        <div class="space-y-8">
          <!-- Small Uppercase Wide-Tracked Label -->
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-block bg-[#143a8a] text-white keep-white font-mono text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.26em] px-3.5 py-1.5">
              SOFTWARE ENGINEER — UI/UX & SYSTEMS ARCHITECTURE
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--accent-secondary)] font-bold">
              HUIT // SOFTWARE ENGINEERING & OPTIMIZATION
            </span>
          </div>

          <!-- Monumental Editorial Serif Name -->
          <div class="space-y-4">
            <h1 class="font-editorial text-[3.6rem] sm:text-[5.25rem] xl:text-[6.4rem] font-bold tracking-[-0.03em] text-[var(--text)] leading-[0.94]">
              Trần Gia Bảo
            </h1>
            <!-- Architectural Dual-Tone Rule -->
            <div class="flex items-center w-full pt-1">
              <div class="h-1.5 w-28 bg-[#d9532f]"></div>
              <div class="h-[2px] flex-1 bg-[var(--line-strong)]"></div>
              <span class="pl-3 font-mono text-[10px] uppercase tracking-[0.24em] text-[var(--text-muted)]">
                GIBOR06 // ATELIER
              </span>
            </div>
          </div>

          <!-- Central Manifesto Statement -->
          <blockquote class="space-y-2 border-l-4 border-[#d9532f] pl-5 py-1">
            <p class="font-editorial italic text-2xl sm:text-4xl lg:text-[2.5rem] text-[var(--text)] leading-[1.15] font-semibold">
              “Where human-centered UI/UX meets resilient Full-Stack engineering.”
            </p>
            {lang === "vi" && (
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent-secondary)] pt-1">
                Nơi thiết kế lấy con người làm trung tâm gặp gỡ kỹ thuật Full-Stack bền bỉ.
              </p>
            )}
          </blockquote>

          <!-- Inspiring Studio Description -->
          <p class="text-[var(--text-secondary)] text-base sm:text-lg leading-[1.75] max-w-2xl font-normal">
            {lang === "vi" ? (
              <>
                Khởi nguồn từ nền tảng Công nghệ phần mềm tại HUIT cùng đam mê nghiên cứu thuật toán tối ưu, tôi kiến tạo những sản phẩm số nơi <strong class="text-[var(--text)] font-semibold">trật tự thị giác chuẩn mực</strong>, <strong class="text-[var(--text)] font-semibold">kiến trúc hệ thống đa tầng bền bỉ</strong> và <strong class="text-[var(--text)] font-semibold">tư duy toán học chặt chẽ</strong> hòa quyện thành một tuyên ngôn thiết kế duy nhất.
              </>
            ) : (
              <>
                Working at the intersection of Software Engineering at HUIT and algorithmic optimization research, I approach digital products as enduring architecture — uniting <strong class="text-[var(--text)] font-semibold">typographic clarity</strong>, <strong class="text-[var(--text)] font-semibold">resilient multi-tier systems</strong>, and <strong class="text-[var(--text)] font-semibold">mathematical rigor</strong> into singular human experiences.
              </>
            )}
          </p>

          <!-- Immediate Honours & Track Record Bar (Visible in first 5 seconds) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 border border-[var(--line-strong)] bg-[var(--bg-elevated)] divide-y sm:divide-y-0 sm:divide-x divide-[var(--line)]">
            <a href="#research" class="p-3.5 hover:bg-[var(--bg-panel)] transition-colors block">
              <div class="font-editorial text-3xl font-bold text-[var(--accent-secondary)] leading-none">02</div>
              <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--text)] font-bold mt-1">
                {lang === "vi" ? "BÀI BÁO QUỐC GIA FAIR ’26" : "FAIR ’26 NATIONAL PAPERS"}
              </div>
            </a>
            <a href="#honours" class="p-3.5 hover:bg-[var(--bg-panel)] transition-colors block">
              <div class="font-editorial text-3xl font-bold text-[var(--accent)] leading-none">08</div>
              <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--text)] font-bold mt-1">
                {lang === "vi" ? "GIẢI THƯỞNG & DANH HIỆU" : "SCIENTIFIC & ACAD. AWARDS"}
              </div>
            </a>
            <a href="#honours" class="p-3.5 hover:bg-[var(--bg-panel)] transition-colors block">
              <div class="font-editorial text-3xl font-bold text-[var(--text)] leading-none">12</div>
              <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--text)] font-bold mt-1">
                {lang === "vi" ? "CHỨNG CHỈ GOOGLE AI & DATA" : "GOOGLE AI & DATA CERTS"}
              </div>
            </a>
            <a href="#works" class="p-3.5 hover:bg-[var(--bg-panel)] transition-colors block">
              <div class="font-editorial text-3xl font-bold text-[var(--accent-secondary)] leading-none">04</div>
              <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--text)] font-bold mt-1">
                {lang === "vi" ? "HỆ THỐNG CHỦ LỰC" : "SIGNATURE ARCHITECTURES"}
              </div>
            </a>
          </div>
        </div>

        <!-- Bottom Left: 4-Theme Atmosphere Bar & Primary Studio Actions -->
        <div class="pt-8 mt-8 border-t border-[var(--line)] space-y-6">
          <!-- Interactive 4-Theme Selector -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 border border-[var(--line-strong)] bg-[var(--bg-elevated)]">
            <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--text-muted)] font-bold">
              {lang === "vi" ? "BẢNG MÀU KIẾN TRÚC (4 CHỦ ĐỀ):" : "ARCHITECTURAL PALETTE (4 THEMES):"}
            </div>
            <div class="grid grid-cols-2 sm:flex items-center gap-1.5 font-mono text-[10px]">
              <button
                type="button"
                data-set-theme="alabaster"
                aria-pressed="true"
                class="px-2.5 py-1.5 font-bold uppercase tracking-wider bg-[#f6f3ec] text-[#0f1e36] border border-[#0f1e36]/40 cursor-pointer flex items-center gap-1.5"
              >
                <span class="h-2.5 w-2.5 bg-[#f6f3ec] border border-[#0f1e36]"></span>
                <span>Alabaster</span>
              </button>
              <button
                type="button"
                data-set-theme="cobalt"
                aria-pressed="false"
                class="px-2.5 py-1.5 font-bold uppercase tracking-wider bg-[#102a63] text-white keep-white border border-[#102a63] cursor-pointer flex items-center gap-1.5"
              >
                <span class="h-2.5 w-2.5 bg-[#143a8a] border border-white"></span>
                <span>Cobalt</span>
              </button>
              <button
                type="button"
                data-set-theme="terracotta"
                aria-pressed="false"
                class="px-2.5 py-1.5 font-bold uppercase tracking-wider bg-[#d9532f] text-white keep-white border border-[#d9532f] cursor-pointer flex items-center gap-1.5"
              >
                <span class="h-2.5 w-2.5 bg-[#f2e5dc] border border-white"></span>
                <span>Terracotta</span>
              </button>
              <button
                type="button"
                data-set-theme="travertine"
                aria-pressed="false"
                class="px-2.5 py-1.5 font-bold uppercase tracking-wider bg-[#e6dfd1] text-[#181a1b] border border-[#181a1b]/40 cursor-pointer flex items-center gap-1.5"
              >
                <span class="h-2.5 w-2.5 bg-[#c84320] border border-[#181a1b]"></span>
                <span>Travertine</span>
              </button>
            </div>
          </div>

          <!-- Editorial Action Links -->
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-3">
              <a href="#honours" class="swiss-btn-primary">
                <span>{lang === "vi" ? "XEM THÀNH TÍCH & GIẢI THƯỞNG" : "EXPLORE HONOURS & AWARDS"}</span>
                <span>↓</span>
              </a>
              <a href="#works" class="swiss-btn-secondary">
                <span>{lang === "vi" ? "TÁC PHẨM TIÊU BIỂU" : "SELECTED WORKS"}</span>
                <span>→</span>
              </a>
            </div>

            <div class="flex items-center gap-5 font-mono text-[11px] uppercase tracking-[0.18em]">
              <a
                href="https://github.com/gibor06"
                target="_blank"
                rel="noreferrer"
                class="font-bold text-[var(--text)] hover:text-[var(--accent-secondary)] border-b border-[var(--line-strong)] pb-0.5 transition-colors"
              >
                GITHUB ↗
              </a>
              <a
                href="https://www.linkedin.com/in/gibor06"
                target="_blank"
                rel="noreferrer"
                class="font-bold text-[var(--text)] hover:text-[var(--accent-secondary)] border-b border-[var(--line-strong)] pb-0.5 transition-colors"
              >
                LINKEDIN ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right 5 Columns: Abstract Architectural Geometry + ARCHITECTURE & UX MATRIX -->
      <div class="lg:col-span-5 bg-[var(--bg-panel)] flex flex-col justify-between">
        
        <!-- Top Right: Abstract Brutalist Color-Block & Geometric Composition -->
        <div class="p-6 sm:p-8 border-b border-[var(--line-strong)] relative overflow-hidden">
          <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--text-muted)] mb-4">
            <span>FIG 01 // ARCHITECTURAL PROJECTION</span>
            <span>SCALE 1 : 1.618</span>
          </div>

          <div class="grid grid-cols-12 border-2 border-[var(--line-strong)] bg-[var(--bg-elevated)] shadow-[8px_8px_0px_var(--shadow-color)]">
            <div class="col-span-7 bg-[#143a8a] p-6 flex flex-col justify-between min-h-[210px] relative overflow-hidden">
              <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/80 keep-white z-10">
                STRUCTURAL HARMONY
              </div>
              <svg
                class="w-full h-32 text-white keep-white my-2"
                viewBox="0 0 240 120"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <line x1="0" y1="60" x2="240" y2="60" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" />
                <line x1="120" y1="0" x2="120" y2="120" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" />
                <circle cx="90" cy="60" r="46" stroke="currentColor" stroke-width="1.75" />
                <circle cx="136" cy="60" r="28" stroke="#d9532f" stroke-width="2" />
                <rect x="44" y="14" width="92" height="92" stroke="currentColor" stroke-opacity="0.5" stroke-width="1" />
                <line x1="44" y1="106" x2="196" y2="14" stroke="currentColor" stroke-width="1.25" />
                <circle cx="90" cy="60" r="3.5" fill="#d9532f" />
                <circle cx="136" cy="60" r="3.5" fill="currentColor" />
              </svg>
              <div class="flex items-center justify-between font-mono text-[10px] text-white keep-white tracking-[0.18em] z-10">
                <span>HUMAN FORM</span>
                <span>×</span>
                <span>SYSTEM LOGIC</span>
              </div>
            </div>

            <div class="col-span-5 flex flex-col border-l border-[var(--line-strong)]">
              <div class="flex-1 bg-[#d9532f] p-5 flex flex-col justify-between text-white keep-white">
                <span class="font-mono text-[10px] uppercase tracking-[0.22em] opacity-85">EDITION</span>
                <span class="font-editorial italic text-3xl sm:text-4xl font-bold leading-none">
                  Folio ’26
                </span>
                <span class="font-mono text-[9px] uppercase tracking-[0.18em] opacity-90">
                  SAIGON // HUIT
                </span>
              </div>
              <div class="flex-1 bg-[#e6dfd1] text-[#181a1b] p-5 border-t border-[var(--line-strong)] flex flex-col justify-between relative">
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#5c6f8c] font-bold">
                  DISCIPLINE
                </span>
                <div class="font-mono text-xs font-bold uppercase tracking-[0.14em] leading-snug">
                  DESIGN SYSTEMS<br />FULL-STACK<br />OPTIMIZATION
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Right: ARCHITECTURE & UX MATRIX (Required 4-Cell Matrix) -->
        <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
          <div class="border-2 border-[var(--line-strong)] bg-[var(--bg-elevated)] shadow-[8px_8px_0px_#d9532f]">
            <div class="bg-[#0f1e36] text-white keep-white px-5 py-3 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.2em] font-bold">
              <span class="flex items-center gap-2">
                <span class="h-2 w-2 bg-[#d9532f]"></span>
                <span>ARCHITECTURE & UX MATRIX</span>
              </span>
              <span>01 — 04</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2">
              {matrixCells.map((cell, idx) => (
                <div
                  class:list={[
                    "p-5 space-y-2 transition-colors hover:bg-[var(--bg-panel)]",
                    idx % 2 === 0 ? "sm:border-r border-[var(--line)]" : "",
                    idx < 2 ? "border-b border-[var(--line)]" : "",
                    idx === 2 ? "border-b sm:border-b-0 border-[var(--line)]" : "",
                  ]}
                >
                  <div class="font-mono text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--accent-secondary)]">
                    {cell.index}
                  </div>
                  <h2 class="font-editorial text-xl font-bold text-[var(--text)] leading-tight">
                    {lang === "vi" ? cell.titleVi : cell.title}
                  </h2>
                  <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                    {lang === "vi" ? cell.descVi : cell.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom 4-Pillar Editorial Index Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-x border-t border-[var(--line-strong)]">
      <a href="#expertise" class="p-5 bg-[#143a8a] text-white keep-white border-b sm:border-b-0 sm:border-r border-white/20 hover:bg-[#102a63] transition-colors group">
        <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-[#ffd4c8] keep-white font-bold">01 // PILLAR I</div>
        <div class="font-editorial text-2xl font-bold mt-1 text-white keep-white group-hover:translate-x-1 transition-transform">UI/UX & Systems Architecture</div>
      </a>
      <a href="#expertise" class="p-5 bg-[#0f1e36] text-white keep-white border-b sm:border-b-0 lg:border-r border-white/20 hover:bg-[#143a8a] transition-colors group">
        <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-[#9eb8f0] keep-white font-bold">02 // PILLAR II</div>
        <div class="font-editorial text-2xl font-bold mt-1 text-white keep-white group-hover:translate-x-1 transition-transform">Full-Stack Engineering</div>
      </a>
      <a href="#expertise" class="p-5 bg-[#143a8a] text-white keep-white border-b sm:border-b-0 sm:border-r border-white/20 hover:bg-[#102a63] transition-colors group">
        <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-[#ffd4c8] keep-white font-bold">03 // PILLAR III</div>
        <div class="font-editorial text-2xl font-bold mt-1 text-white keep-white group-hover:translate-x-1 transition-transform">Data & Infrastructure</div>
      </a>
      <a href="#honours" class="p-5 bg-[#d9532f] text-white keep-white hover:bg-[#b83f1d] transition-colors group">
        <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/90 keep-white font-bold">04 // HONOURS & AI</div>
        <div class="font-editorial text-2xl font-bold mt-1 text-white keep-white group-hover:translate-x-1 transition-transform">08 Awards & FAIR XIX ’26</div>
      </a>
    </div>
  </div>
</section>

---
import { certificates } from '@data/certificates';
import { getRelativeLocaleUrl, withBase } from '@i18n/utils';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section id="certifications" class="relative py-20 sm:py-24 border-b border-white/[0.14] bg-[#080b12]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <div class="reveal-on-scroll flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-white/[0.14] pb-8">
      <div class="space-y-3">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#4d8dff]">
          05 // {isVi ? "CHỨNG CHỈ CHUYÊN MÔN QUỐC TẾ" : "PROFESSIONAL CERTIFICATIONS"}
        </div>
        <h2 class="display-section-title uppercase">
          {isVi ? "Chứng Chỉ Google Data Analytics & Google AI" : "Google Data Analytics & Google AI Credentials"}
        </h2>
      </div>
      <p class="max-w-xl text-sm text-zinc-300 leading-relaxed">
        {isVi
          ? "12 chứng chỉ chuyên môn được cấp bởi Google (qua Coursera) với liên kết xác thực trực tuyến và bản gốc PDF."
          : "12 verified industry credentials issued by Google (via Coursera) with direct verification URLs and original PDF documents."}
      </p>
    </div>

    <!-- Certificates Table/Grid -->
    <div class="reveal-on-scroll grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-white/[0.14]">
      {certificates.filter((c) => c.highlight).map((cert, idx) => {
        const title = isVi ? cert.titleVi : cert.titleEn;
        return (
          <div class="border-r border-b border-white/[0.14] bg-[#0a0e16] p-6 flex flex-col justify-between gap-5 hover:bg-white/[0.02] transition-colors">
            <div class="space-y-3">
              <div class="flex items-center justify-between font-mono text-[11px] text-zinc-400">
                <span class="text-[#4d8dff] font-bold">CERT-0{idx + 1}</span>
                <span>{cert.date} // {cert.category.toUpperCase()}</span>
              </div>
              <h3 class="text-base font-bold text-white leading-snug">
                {title}
              </h3>
              <p class="font-mono text-xs text-zinc-400">
                {cert.issuer}
              </p>
            </div>

            <div class="pt-4 border-t border-white/[0.10] flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
              {cert.imagePath && (
                <button
                  type="button"
                  data-lightbox
                  data-src={withBase(cert.imagePath)}
                  data-caption={`${title} — ${cert.issuer}`}
                  class="text-white hover:text-[#4d8dff] uppercase tracking-wider cursor-pointer"
                >
                  {isVi ? "[Xem Chứng Chỉ]" : "[Preview Image]"}
                </button>
              )}
              <div class="flex items-center gap-3">
                {cert.pdfPath && (
                  <a
                    href={withBase(cert.pdfPath)}
                    target="_blank"
                    rel="noreferrer"
                    class="text-zinc-400 hover:text-white uppercase tracking-wider"
                  >
                    PDF ↗
                  </a>
                )}
                {cert.credentialUrl && (
                  <a
                    href={cert.credentialUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="text-[#4d8dff] hover:underline uppercase tracking-wider font-semibold"
                  >
                    {isVi ? "Xác thực ↗" : "Verify ↗"}
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="reveal-on-scroll flex justify-end">
      <a href={getRelativeLocaleUrl(lang, "/credentials")} class="swiss-btn-secondary">
        <span>{isVi ? "Xem tất cả 12 chứng chỉ chuyên môn →" : "Inspect All 12 Professional Certificates →"}</span>
      </a>
    </div>
  </div>
</section>

---
import { skillGroups } from '@data/skills';
import { getRelativeLocaleUrl } from '@i18n/utils';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section id="capabilities" class="relative py-20 sm:py-28 border-b border-white/[0.14] bg-[#080b12]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-14">
    <!-- Section Header -->
    <div class="reveal-on-scroll flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-white/[0.14] pb-8">
      <div class="space-y-3">
        <div class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#4d8dff]">
          02 // {isVi ? "MA TRẬN NĂNG LỰC KỸ THUẬT" : "TECHNICAL CAPABILITIES MATRIX"}
        </div>
        <h2 class="display-section-title uppercase">
          {isVi ? "Công Nghệ Sử Dụng & Bằng Chứng Thực Thi" : "Verified Stack & Project Evidence"}
        </h2>
      </div>
      <p class="max-w-xl text-sm text-zinc-300 leading-relaxed">
        {isVi
          ? "Mỗi nhóm kỹ năng đều gắn liền với dự án, cơ sở dữ liệu hoặc công trình nghiên cứu đã triển khai thực tế — không sử dụng thanh phần trăm cảm tính."
          : "Every technical capability listed below is backed by inspectable source code, database schemas, or published academic research — zero arbitrary percentage bars."}
      </p>
    </div>

    <!-- 5-Domain Architectural Grid -->
    <div class="reveal-on-scroll grid grid-cols-1 lg:grid-cols-12 border-t border-l border-white/[0.14]">
      {skillGroups.map((group, idx) => {
        const colSpan = idx < 2 ? "lg:col-span-6" : "lg:col-span-4";
        return (
          <div class={`${colSpan} border-r border-b border-white/[0.14] bg-[#0a0e16] p-6 sm:p-8 flex flex-col justify-between space-y-8`}>
            <div class="space-y-5">
              <div class="flex items-center justify-between font-mono text-xs border-b border-white/[0.10] pb-3">
                <span class="text-[#4d8dff] font-bold">{group.index} // DOMAIN</span>
                <span class="text-zinc-500 uppercase">{group.primarySkills.length} {isVi ? "Công nghệ chính" : "Core Technologies"}</span>
              </div>

              <div class="space-y-2">
                <h3 class="text-xl sm:text-2xl font-extrabold text-white uppercase tracking-tight">
                  {isVi ? group.titleVi : group.titleEn}
                </h3>
                <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
                  {isVi ? group.descriptionVi : group.descriptionEn}
                </p>
              </div>

              <!-- Primary & Working Skills Tags -->
              <div class="flex flex-wrap gap-1.5">
                {group.primarySkills.map((s) => (
                  <span class="swiss-tag border-[#4d8dff]/40 text-white">{s}</span>
                ))}
                {group.workingSkills.map((s) => (
                  <span class="swiss-tag text-zinc-400">{s}</span>
                ))}
              </div>

              <!-- Concrete Implementation Items -->
              <div class="divide-y divide-white/[0.10] border-t border-white/[0.10] pt-2">
                {group.items.map((skill) => (
                  <div class="py-3.5 space-y-1.5">
                    <h4 class="font-mono text-xs sm:text-sm font-bold text-white">
                      ▪ {skill.name}
                    </h4>
                    <p class="text-xs text-zinc-300 leading-relaxed pl-3.5">
                      {isVi ? skill.contextVi : skill.contextEn}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Verified Project Evidence Links -->
            <div class="pt-4 border-t border-white/[0.12] space-y-2">
              <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">
                {isVi ? "DỰ ÁN MINH CHỨNG:" : "VERIFIED IN PROJECTS:"}
              </div>
              <div class="flex flex-wrap gap-2">
                {group.evidenceLinks.map((ev) => {
                  const isExternal = ev.href.startsWith("http");
                  const targetHref = isExternal ? ev.href : getRelativeLocaleUrl(lang, ev.href);
                  return (
                    <a
                      href={targetHref}
                      target={isExternal ? "_blank" : undefined}
                      rel={isExternal ? "noreferrer" : undefined}
                      class="inline-flex items-center gap-1.5 border border-white/15 bg-white/[0.03] px-2.5 py-1 font-mono text-[11px] text-[#4d8dff] hover:bg-[#4d8dff] hover:text-white hover:border-[#4d8dff] transition-colors"
                    >
                      <span>{isVi ? ev.labelVi : ev.labelEn}</span>
                      <span>{isExternal ? "↗" : "→"}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

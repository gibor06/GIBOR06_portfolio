---
import { skillGroups } from '@data/skills';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;

const explorationAreas = [
  {
    id: "01",
    title: "High-Utility Itemset Mining (EMHUN)",
    desc: "Researching dynamic transaction databases with negative/positive utility and efficient search space pruning.",
    descVi: "Nghiên cứu cơ sở dữ liệu giao dịch động với độ hữu ích âm/dương và tối ưu không gian tìm kiếm (thuật toán EMHUN).",
  },
  {
    id: "02",
    title: "Transformer NLP & Toxic Speech Moderation",
    desc: "Fine-tuning contextual transformer architectures (PhoBERT) for Vietnamese comment classification and intent detection.",
    descVi: "Tinh chỉnh mô hình Transformer (PhoBERT) cho bài toán phân loại bình luận tiếng Việt theo ngữ cảnh.",
  },
  {
    id: "03",
    title: "Computer Vision & Agricultural AI",
    desc: "Evaluating YOLO and Vision Transformers (SAM-ViT) for real-time feature segmentation and disease detection.",
    descVi: "Đánh giá mô hình YOLO và Vision Transformers (SAM-ViT) trong nhận diện đối tượng và phân đoạn đặc trưng nông nghiệp.",
  },
  {
    id: "04",
    title: "Systems Programming & Deterministic Code",
    desc: "Developing memory-safe C/C++ data structures, low-latency APIs, and high-performance web systems.",
    descVi: "Xây dựng cấu trúc dữ liệu C/C++ tối ưu bộ nhớ, API độ trễ thấp và ứng dụng web hiệu năng cao.",
  }
];
---

<section id="engineering-profile" class="py-24 md:py-36 border-t border-white/[0.08] relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Section Title with Large Number Rhythm -->
    <div class="flex items-baseline justify-between border-b border-white/[0.08] pb-6">
      <div class="space-y-1">
        <span class="font-mono text-xs text-blue-400 uppercase tracking-widest block">04 // INDEX</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          {lang === "vi" ? "NĂNG LỰC KỸ THUẬT & NGHIÊN CỨU" : "ENGINEERING CAPABILITIES"}
        </h2>
      </div>
      <span class="display-section-num hidden sm:block">04</span>
    </div>

    <!-- Active Research & Engineering Domains (Editorial Split) -->
    <div class="space-y-8">
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block">
        {lang === "vi" ? "LĨNH VỰC NGHIÊN CỨU & PHÁT TRIỂN CHÍNH // CURRENT EXPLORATIONS" : "PRIMARY RESEARCH & SYSTEMS DOMAINS"}
      </span>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        {explorationAreas.map((area) => (
          <div class="space-y-2 pb-6 border-b border-white/[0.06]">
            <span class="font-mono text-xs text-blue-400 font-bold">AREA {area.id}</span>
            <h3 class="text-xl font-bold text-white tracking-tight">
              {area.title}
            </h3>
            <p class="text-sm text-zinc-300 font-light leading-relaxed">
              {lang === "vi" ? area.descVi : area.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Editorial Typography Taxonomy (No Badge Soup!) -->
    <div class="space-y-8 pt-12 border-t border-white/[0.08]">
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block">
        {lang === "vi" ? "NGĂN XẾP CÔNG NGHỆ (CORE TAXONOMY)" : "TECHNICAL STACK & CORE COMPETENCIES"}
      </span>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {skillGroups.map((group) => (
          <div class="space-y-4">
            <h4 class="text-lg font-bold text-white tracking-tight">
              {lang === "vi" ? group.titleVi : group.titleEn}
            </h4>

            <div class="space-y-2 font-mono text-xs">
              <span class="text-zinc-500 text-[11px] uppercase block">
                {lang === "vi" ? "NÒNG CỐT:" : "PRIMARY FOCUS:"}
              </span>
              <div class="text-sm font-sans font-medium text-white flex flex-wrap gap-x-4 gap-y-1">
                {group.primarySkills.map((sk) => (
                  <span class="text-zinc-200">{sk}</span>
                ))}
              </div>
            </div>

            <div class="space-y-2 font-mono text-xs pt-2 border-t border-white/[0.06]">
              <span class="text-zinc-500 text-[11px] uppercase block">
                {lang === "vi" ? "BỔ TRỢ:" : "WORKING KNOWLEDGE:"}
              </span>
              <div class="text-xs font-sans text-zinc-400 flex flex-wrap gap-x-4 gap-y-1">
                {group.workingSkills.map((sk) => (
                  <span>{sk}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

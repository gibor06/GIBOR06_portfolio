---
---

<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Dynamic Signal Canvas -->
  <canvas id="signalFieldCanvas" class="w-full h-full block opacity-60"></canvas>

  <!-- Technical Coordinate Marks (Extremely low contrast 2-4%) -->
  <div class="absolute inset-0 select-none pointer-events-none opacity-[0.035] font-mono text-[9px] text-white">
    <div class="absolute top-16 left-8">COORD // 10.8231° N, 106.6297° E</div>
    <div class="absolute top-16 right-8 text-right">SYS // GIBOR06_V5</div>
    <div class="absolute top-1/2 left-8 -translate-y-1/2">SIGNAL.GRID // TRAN GIA BAO</div>
    <div class="absolute bottom-12 right-8 text-right">TOPOGRAPHY // ACTIVE</div>
  </div>
</div>

<script>
  (function () {
    const canvas = document.getElementById("signalFieldCanvas") as HTMLCanvasElement;
    if (!canvas) return;

    const rawCtx = canvas.getContext("2d");
    if (!rawCtx) return;
    const ctx = rawCtx;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animationId: number;
    let isVisible = true;

    // Mouse state for gentle viscous deflection
    const mouse = { x: -1000, y: -1000, targetX: -1000, targetY: -1000, radius: 120 };

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      baseSpeed: number;
      size: number;
      alpha: number;
      noiseSeed: number;
    }

    let particles: Particle[] = [];

    function resize() {
      if (!canvas || !ctx) return;
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);
      initParticles();
    }

    function initParticles() {
      particles = [];
      const isMobile = width < 768;
      // Sparse particle density (cleaner, more editorial)
      const count = isMobile ? Math.floor((width * height) / 28000) : Math.floor((width * height) / 16000);

      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: 0,
          vy: 0,
          baseSpeed: Math.random() * 0.25 + 0.1,
          size: Math.random() < 0.1 ? 2.0 : 1.0,
          alpha: Math.random() * 0.25 + 0.08,
          noiseSeed: Math.random() * 1000,
        });
      }
    }

    // Topographic contour line drawing
    function drawTopography(time: number) {
      const lineCount = 3;
      ctx.lineWidth = 0.5;

      for (let l = 0; l < lineCount; l++) {
        const yOffset = (height * 0.35) + (l * 180);
        ctx.beginPath();
        
        for (let x = 0; x <= width; x += 40) {
          const wave1 = Math.sin(x * 0.0012 + time * 0.00015 + l * 1.5) * 45;
          const wave2 = Math.cos(x * 0.0025 - time * 0.0001 + l) * 25;
          const y = yOffset + wave1 + wave2;

          if (x === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }

        ctx.strokeStyle = `rgba(120, 183, 255, 0.035)`;
        ctx.stroke();
      }
    }

    let lastTime = performance.now();

    function render(currentTime: number) {
      if (!isVisible || !ctx) return;
      const dt = Math.min((currentTime - lastTime) / 1000, 0.1);
      lastTime = currentTime;

      // Smooth mouse easing
      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      ctx.clearRect(0, 0, width, height);

      // 1. Draw subtle topographic contour waves
      drawTopography(currentTime);

      // 2. Draw sparse particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const angle = Math.sin(p.x * 0.001 + currentTime * 0.0001) * Math.cos(p.y * 0.001) * Math.PI * 2;

        const targetVx = Math.cos(angle) * p.baseSpeed;
        const targetVy = Math.sin(angle) * p.baseSpeed;
        p.vx += (targetVx - p.vx) * 0.04;
        p.vy += (targetVy - p.vy) * 0.04;

        // Subtle pointer deflection
        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const dist = Math.hypot(dx, dy);
        if (dist < mouse.radius && dist > 0) {
          const force = (1 - dist / mouse.radius) * 0.6;
          p.x -= (dx / dist) * force;
          p.y -= (dy / dist) * force;
        }

        p.x += p.vx * dt * 60;
        p.y += p.vy * dt * 60;

        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(164, 166, 168, ${p.alpha * 0.6})`;
        ctx.fill();
      }

      animationId = requestAnimationFrame(render);
    }

    if (window.innerWidth >= 768) {
      window.addEventListener("pointermove", (e) => {
        mouse.targetX = e.clientX;
        mouse.targetY = e.clientY;
      }, { passive: true });

      window.addEventListener("pointerleave", () => {
        mouse.targetX = -1000;
        mouse.targetY = -1000;
      });
    }

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        isVisible = false;
        cancelAnimationFrame(animationId);
      } else {
        isVisible = true;
        lastTime = performance.now();
        animationId = requestAnimationFrame(render);
      }
    });

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    resize();
    animationId = requestAnimationFrame(render);
  })();
</script>

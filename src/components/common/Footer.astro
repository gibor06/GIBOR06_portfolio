---
import { getRelativeLocaleUrl } from '@i18n/utils';

export interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const currentYear = new Date().getFullYear();
const homeUrl = getRelativeLocaleUrl(lang, "/");
---

<footer class="border-t-2 border-[var(--line-strong)] bg-[#0f1e36] text-white keep-white font-mono text-xs relative z-10 no-print">
  <!-- Top 4-Color Architectural Accent Strip -->
  <div class="grid grid-cols-12 h-2">
    <div class="col-span-4 bg-[#143a8a]"></div>
    <div class="col-span-4 bg-[#d9532f]"></div>
    <div class="col-span-4 bg-[#e6dfd1]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-white/20">
      <!-- Col 1: Studio Identity -->
      <div class="lg:col-span-6 py-12 lg:pr-10 lg:border-r border-white/20 space-y-4">
        <div class="inline-flex items-center gap-2 bg-[#d9532f] text-white keep-white px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em]">
          <span>GIBOR06 STUDIO // FOLIO 2026</span>
        </div>
        <div class="font-editorial text-4xl sm:text-5xl font-bold text-white keep-white tracking-tight">
          Trần Gia Bảo
        </div>
        <p class="text-white/85 keep-white font-editorial italic text-xl max-w-xl leading-relaxed">
          “Where human-centered UI/UX meets resilient Full-Stack engineering.”
        </p>
      </div>

      <!-- Col 2: Index Navigation -->
      <div class="lg:col-span-3 py-10 lg:px-8 border-t lg:border-t-0 lg:border-r border-white/20 space-y-3">
        <div class="text-[10px] uppercase tracking-[0.22em] text-[#ffd4c8] keep-white font-bold">
          {lang === "vi" ? "MỤC LỤC KIẾN TRÚC" : "STUDIO INDEX"}
        </div>
        <ul class="space-y-2.5 text-xs uppercase tracking-[0.14em]">
          <li><a href={`${homeUrl}#about`} class="text-white/80 keep-white hover:text-white transition-colors">01 // {lang === "vi" ? "Tuyên ngôn" : "About"}</a></li>
          <li><a href={`${homeUrl}#expertise`} class="text-white/80 keep-white hover:text-white transition-colors">02 // {lang === "vi" ? "Năng lực" : "Expertise"}</a></li>
          <li><a href={`${homeUrl}#works`} class="text-white/80 keep-white hover:text-white transition-colors">03 // {lang === "vi" ? "Tác phẩm" : "Selected Works"}</a></li>
          <li><a href={`${homeUrl}#research`} class="text-white/80 keep-white hover:text-white transition-colors">04 // {lang === "vi" ? "Nghiên cứu" : "Research"}</a></li>
          <li><a href={`${homeUrl}#contact`} class="text-white/80 keep-white hover:text-white transition-colors">05 // {lang === "vi" ? "Liên hệ" : "Contact"}</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Channels -->
      <div class="lg:col-span-3 py-10 lg:pl-8 border-t lg:border-t-0 border-white/20 space-y-3">
        <div class="text-[10px] uppercase tracking-[0.22em] text-[#ffd4c8] keep-white font-bold">
          {lang === "vi" ? "KẾT NỐI TRỰC TIẾP" : "DIRECT CHANNELS"}
        </div>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="mailto:gibor06.dev@gmail.com" class="text-white keep-white font-bold hover:underline transition-colors break-all">
              gibor06.dev@gmail.com ↗
            </a>
          </li>
          <li>
            <a href="https://github.com/gibor06" target="_blank" rel="noreferrer" class="text-white/85 keep-white hover:text-white transition-colors">
              github.com/gibor06 ↗
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/gibor06" target="_blank" rel="noreferrer" class="text-white/85 keep-white hover:text-white transition-colors">
              linkedin.com/in/gibor06 ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Colophon + 4-Theme Quick Switcher -->
    <div class="py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-white/75 keep-white">
      <p class="uppercase tracking-[0.16em]">
        © {currentYear} Trần Gia Bảo (gibor06) — SAIGON, VIETNAM.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-1">
          <button type="button" data-set-theme="alabaster" class="px-2 py-0.5 border border-white/30 text-[10px] text-white keep-white uppercase cursor-pointer">Alabaster</button>
          <button type="button" data-set-theme="cobalt" class="px-2 py-0.5 border border-white/30 text-[10px] text-white keep-white uppercase cursor-pointer">Cobalt</button>
          <button type="button" data-set-theme="terracotta" class="px-2 py-0.5 border border-white/30 text-[10px] text-white keep-white uppercase cursor-pointer">Terracotta</button>
          <button type="button" data-set-theme="travertine" class="px-2 py-0.5 border border-white/30 text-[10px] text-white keep-white uppercase cursor-pointer">Travertine</button>
        </div>
        <a href="#main-content" class="text-white keep-white font-bold hover:underline transition-colors uppercase tracking-wider">
          ↑ TOP
        </a>
      </div>
    </div>
  </div>
</footer>
